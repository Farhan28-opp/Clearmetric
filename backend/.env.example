# Copy to backend/.env and adjust. Every setting is optional; defaults run fully offline.

# Persistence: SQLite by default; PostgreSQL for multi-user deployment
# CM_DATABASE_URL=postgresql+psycopg://clearmetric:secret@localhost:5432/clearmetric
# CM_STORAGE_DIR=/var/lib/clearmetric/storage

CM_ENVIRONMENT=development
# Set true behind HTTPS so session cookies are Secure
CM_COOKIE_SECURE=false
CM_FRONTEND_URL=http://localhost:3000

# Limits (tune to your deployment's capacity)
CM_MAX_UPLOAD_MB=50
CM_MAX_ROWS=1000000
CM_QUERY_TIMEOUT_SECONDS=15

# Optional Claude provider. Leave unset for the deterministic local analyst.
# Even when configured, a workspace owner/admin must enable "External AI" in Settings → Data privacy.
# CM_AI_PROVIDER=anthropic
# CM_ANTHROPIC_API_KEY=sk-ant-...
# CM_ANTHROPIC_MODEL=claude-sonnet-5-5
